generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  name              String
  email             String    @unique
  password          String
  role              Role
  phone             String
  emailVerifiedAt   DateTime?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  clientProfile     ClientProfile?
  muaProfile        MuaProfile?

  clientBookings Booking[] @relation("ClientBookings")
  sentMessages     Message[]  @relation("SentMessages")
  receivedMessages Message[]  @relation("ReceivedMessages")
  clientReviews    Review[]   @relation("ClientReviews")

  @@map("users")
}

enum Role {
  client
  mua
  admin
}

model ClientProfile {
  id                   Int       @id @default(autoincrement())
  userId               String    @unique
  avatarUrl            String?
  defaultLocation      String?
  skinType             SkinType?
  skinTone             String?
  skinConditions       Json?
  sensitiveIngredients Json?
  preferredStyles      Json?
  preferredEvents      Json?
  updatedAt            DateTime  @updatedAt

  user                 User      @relation(fields: [userId], references: [id])

  @@map("client_profiles")
}

enum SkinType {
  normal
  oily
  dry
  combination
  sensitive
}

model MuaProfile {
  id                     Int       @id @default(autoincrement())
  userId                 String    @unique
  brandName              String
  avatarUrl              String?
  bio                    String?
  operationalLocation    String
  yearsExperience        Int?
  specializations        Json
  makeupStyles           Json
  canUseOwnSkinprep      Boolean   @default(true)
  canUseClientSkinprep   Boolean   @default(true)
  ownSkinprepIngredients Json?
  transportType          TransportType @default(per_km)
  transportFlatFee       Decimal?
  transportPerKmRate     Decimal?
  ratingAvg              Decimal   @default(0)
  reviewCount            Int       @default(0)
  isVerified             Boolean   @default(false)
  deletedAt              DateTime?

  user                   User      @relation(fields: [userId], references: [id])
  servicePackages        ServicePackage[]
  packageAddons          PackageAddon[]
  schedules              MuaSchedule[]
  bookings               Booking[]
  reviews                Review[]
  messages               Message[]

  @@map("mua_profiles")
}

enum TransportType {
  flat
  per_km
  free
}

model ServicePackage {
  id               Int      @id @default(autoincrement())
  muaProfileId     Int
  name             String
  description      String?
  basePrice        Decimal  @db.Decimal(12, 2)
  durationMinutes  Int
  includedServices Json
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)

  muaProfile       MuaProfile     @relation(fields: [muaProfileId], references: [id])
  addons           PackageAddon[]
  bookings         Booking[]

  @@map("service_packages")
}

model PackageAddon {
  id                Int            @id @default(autoincrement())
  muaProfileId      Int
  servicePackageId  Int?
  name              String
  description       String?
  price             Decimal        @db.Decimal(12, 2)
  isActive          Boolean        @default(true)

  muaProfile        MuaProfile     @relation(fields: [muaProfileId], references: [id])
  servicePackage    ServicePackage? @relation(fields: [servicePackageId], references: [id])

  @@map("package_addons")
}

model MuaSchedule {
  id           Int      @id @default(autoincrement())
  muaProfileId Int
  date         DateTime @db.Date
  startTime    String
  endTime      String
  isBlocked    Boolean  @default(false)

  muaProfile   MuaProfile @relation(fields: [muaProfileId], references: [id])
  booking      Booking? @relation(fields: [bookingId], references: [id])
  bookingId    Int?     @unique @map("booking_id")

  @@map("mua_schedules")
}

model Booking {
  id             Int      @id @default(autoincrement())
  bookingCode    String   @unique @map("booking_code")
  clientId       String   @map("client_id")
  muaProfileId   Int      @map("mua_profile_id")
  packageId      Int      @map("package_id")
  selectedAddons Json?    @map("selected_addons")
  sessionDate    DateTime @map("session_date") @db.Date
  sessionStart   String   @map("session_start")
  sessionLocation String  @map("session_location")
  clientNotes    String?  @map("client_notes")
  basePrice      Decimal  @map("base_price") @db.Decimal(12, 2)
  addonsPrice    Decimal  @default(0) @map("addons_price") @db.Decimal(12, 2)
  transportFee   Decimal  @default(0) @map("transport_fee") @db.Decimal(12, 2)
  totalPrice     Decimal  @map("total_price") @db.Decimal(12, 2)
  status         String   @default("pending")
  rejectionReason String? @map("rejection_reason")
  cancelledBy    String?  @map("cancelled_by")
  createdAt      DateTime @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  client     User           @relation("ClientBookings", fields: [clientId], references: [id])
  muaProfile MuaProfile     @relation(fields: [muaProfileId], references: [id])
  package    ServicePackage @relation(fields: [packageId], references: [id])
  payment    Payment?
  schedule   MuaSchedule?
  review     Review?

  @@map("bookings")
}

model Payment {
  id              Int      @id @default(autoincrement())
  bookingId       Int      @unique @map("booking_id")
  midtransOrderId String?  @unique @map("midtrans_order_id")
  amount          Decimal  @db.Decimal(12, 2)
  method          String?
  status          String   @default("pending")
  paidAt          DateTime? @map("paid_at")
  disbursedAt     DateTime? @map("disbursed_at")

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("payments")
}

model Review {
  id           String   @id @default(uuid())
  bookingId    Int      @unique @map("booking_id")
  clientId     String   @map("client_id")
  muaProfileId Int      @map("mua_profile_id")
  rating       Int
  content      String?
  photoUrls    Json?    @map("photo_urls")
  muaReply     String?  @map("mua_reply")
  createdAt    DateTime @default(now()) @map("created_at")

  booking    Booking    @relation(fields: [bookingId], references: [id])
  client     User       @relation("ClientReviews", fields: [clientId], references: [id])
  muaProfile MuaProfile @relation(fields: [muaProfileId], references: [id])

  @@map("reviews")
}

model Message {
  id           String   @id @default(uuid())
  senderId     String   @map("sender_id")
  receiverId   String   @map("receiver_id")
  muaProfileId Int      @map("mua_profile_id")
  content      String
  createdAt    DateTime @default(now()) @map("created_at")

  sender     User       @relation("SentMessages", fields: [senderId], references: [id])
  receiver   User       @relation("ReceivedMessages", fields: [receiverId], references: [id])
  muaProfile MuaProfile @relation(fields: [muaProfileId], references: [id])

  @@map("messages")
}